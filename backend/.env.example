# Server
PORT=4000
NODE_ENV=development

# Neon PostgreSQL (get this from your Neon project dashboard)
DATABASE_URL=postgresql://username:password@ep-xxx-xxx.us-east-1.aws.neon.tech/cashdesk?sslmode=require

# JWT
JWT_SECRET=change_this_to_a_long_random_secret_key_minimum_32_characters
JWT_EXPIRES_IN=8h

# CORS — comma-separated allowed origins
CORS_ORIGINS=http://localhost:3000,http://localhost:8081
